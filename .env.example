# ==============================================================================
# Sahaara — Environment Configuration Template
# ==============================================================================
# Guidelines:
# - Copy this file to `.env` for local development.
# - VITE_* variables are PUBLIC and embedded into the client browser bundle at build time.
# - All other variables are SERVER-ONLY and must NEVER be exposed to the client.
# - Do NOT commit real API keys, tokens, or production passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# A. Application Configuration
# ------------------------------------------------------------------------------
# Public origin URL of the Sahaara application (used for webhooks and auth callbacks)
APP_URL=https://saharaa-1.vercel.app
NODE_ENV=development
PORT=8080

# ------------------------------------------------------------------------------
# B. PostgreSQL Database & Storage
# ------------------------------------------------------------------------------
# [IMPLEMENTED: Managed Supabase PostgreSQL with Row Level Security]
# Public Supabase credentials (inlined into client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_or_anon_key
VITE_SUPABASE_ANON_KEY=your_public_publishable_or_anon_key

# Server-side Supabase credentials (access to database and auth verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_public_publishable_or_anon_key
SUPABASE_ANON_KEY=your_public_publishable_or_anon_key

# Privileged service role key (SERVER-ONLY: required for append-only risk assessments & migrations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# [PLANNED: Target Dedicated PostgreSQL Connection for standalone Docker/FastAPI]
DATABASE_URL=postgresql://postgres:password@localhost:5432/sahaara
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sahaara
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# ------------------------------------------------------------------------------
# C. Ollama & Qwen3 (Local AI Inference)
# ------------------------------------------------------------------------------
# [PLANNED: Target local LLM runtime for data sovereignty and offline inference]
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ------------------------------------------------------------------------------
# D. Whisper (Speech-to-Text Audio Transcription)
# ------------------------------------------------------------------------------
# [IMPLEMENTED: Cloud Groq Whisper API] / [PLANNED: Local Self-Hosted Whisper]
WHISPER_BASE_URL=http://localhost:9000
WHISPER_MODEL=whisper-large-v3-turbo

# ------------------------------------------------------------------------------
# E. FastAPI & Backend AI Microservice
# ------------------------------------------------------------------------------
# [PLANNED: Target Python microservice for local model orchestration and biometrics]
API_BASE_URL=http://localhost:8000
API_SECRET_KEY=your_internal_fastapi_shared_secret

# ------------------------------------------------------------------------------
# F. Twilio WhatsApp Integration
# ------------------------------------------------------------------------------
# [IMPLEMENTED: Two-way WhatsApp messaging, appointment reminders, Groq clinical bot]
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_secret
TWILIO_WHATSAPP_NUMBER=whatsapp:+17372508034
TWILIO_WEBHOOK_URL=https://saharaa-1.vercel.app/api/public/whatsapp

# ------------------------------------------------------------------------------
# G. MinIO (S3-Compatible Private Object Storage)
# ------------------------------------------------------------------------------
# [PLANNED: Target private S3 storage for senior voice notes and document attachments]
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sahaara-recordings
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# H. Redis / Background Workers & Scheduler
# ------------------------------------------------------------------------------
# [PLANNED: Target Redis queue for scheduled wellness check calls & reminder retries]
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
SCHEDULER_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# I. Authentication & Security
# ------------------------------------------------------------------------------
AUTH_SECRET=your_super_secret_jwt_hmac_key_min_32_chars
AUTH_URL=https://saharaa-1.vercel.app

# ------------------------------------------------------------------------------
# J. Wearable Telemetry & Smartwatch Synchronization
# ------------------------------------------------------------------------------
# [IMPLEMENTED: Web dashboard, BLE schemas, 24h baseline generator, JSON import]
# [PLANNED: Android Health Connect background sync layer]
HEALTH_CONNECT_ENABLED=false
WEARABLE_SYNC_SECRET=your_wearable_ingestion_api_secret
WEARABLE_API_BASE_URL=https://saharaa-1.vercel.app/api/wearables

# ------------------------------------------------------------------------------
# K. Additional Cloud AI & Voice Integrations
# ------------------------------------------------------------------------------
# [IMPLEMENTED: Low-latency Groq Cloud LLM for WhatsApp intent routing & cue extraction]
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# [IMPLEMENTED: ElevenLabs text-to-speech for read-aloud senior accessibility]
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=your_verified_elevenlabs_voice_id
