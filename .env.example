# Sahaara environment template — names only, never real values.
# Copy to .env locally. VITE_* values are PUBLIC (shipped to the browser).
# All other values are SERVER-ONLY and must be read inside server handlers.
#
# Phase 0: no variables are required yet. Future phases will add:
#
# Supabase (Public - Client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Supabase (Server-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (Phase 7) — SERVER-ONLY. Never prefix with VITE_.
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional read-aloud; all three required. Use a model/voice verified for your account.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL_ID=
ELEVENLABS_VOICE_ID=

# WhatsApp Business API (Future phases)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
